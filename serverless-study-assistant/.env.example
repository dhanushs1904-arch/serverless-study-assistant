# Environment Configuration for Serverless Study Assistant
# Student: Dhanush S (23MIS0224) | VIT | Agile Development Process and DevOps

# Application Environment
APP_ENV=local
APP_VERSION=1.0.0
DEBUG=true
PORT=8000

# AI Provider Configuration (Groq / LLaMA)
# Get a free API key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Storage Configuration
# Toggle between local SQLite and AWS DynamoDB
AWS_STORAGE_ENABLED=false
S3_ARTIFACTS_ENABLED=false

# AWS Configuration (Used when AWS_STORAGE_ENABLED=true or S3_ARTIFACTS_ENABLED=true)
AWS_REGION=us-east-1
AWS_DYNAMODB_TABLE=StudyAssistantRecords
AWS_S3_BUCKET=vit-study-assistant-artifacts-23mis0224

# Local Storage Paths
SQLITE_DB_PATH=data/study_assistant.db
REPORTS_DIR=data/reports
EVAL_DATASET_PATH=data/evaluation_dataset.json

# Frontend Configuration
FRONTEND_API_BASE_URL=http://127.0.0.1:8000
